/target
# Alternate CARGO_TARGET_DIR names used when building outside the
# default `target/` (e.g. a reviewer pointing CARGO_TARGET_DIR at the
# checkout to avoid contending on the shared directory).
/.cargo-target
# Scratch worktrees used for parallel review/validation checkouts.
/.worktrees
# cargo-fuzz build artifacts and crash corpus. The seed corpus
# under `fuzz/corpus/<target>/` is added with `git add -f` so the
# fuzzer's runtime writes to the same directories stay ignored
# (closes #54).
/fuzz/target
/fuzz/corpus
/fuzz/artifacts
**/*.rs.bk
*.pdb
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.iml
*.orig__pycache__

# Python
__pycache__/
*.py[cod]
