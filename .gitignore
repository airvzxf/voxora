/target
# Alternate CARGO_TARGET_DIR names used when building outside the
# default `target/` (e.g. a reviewer pointing CARGO_TARGET_DIR at the
# checkout to avoid contending on the shared directory).
/.cargo-target
# Scratch worktrees used for parallel review/validation checkouts.
/.worktrees
**/*.rs.bk
*.pdb
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.iml
*.orig

# Python
__pycache__/
*.py[cod]

# Audio/model fixtures downloaded on demand by #[ignore]-gated tests.
**/tests/fixtures/**/*.wav
**/tests/fixtures/**/*.bin
**/tests/fixtures/**/*.gguf
**/tests/fixtures/**/*.safetensors
